{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)",
      "Read(./packages/*/.env)",
      "Read(./packages/*/.env.*)",
      "Write(./CLAUDE.md)",
      "Write(./LICENSE)",
      "Write(./README.md)",
      "Write(./CONTRIBUTING.md)",
      "Write(./biome.json)",
      "Write(./lefthook.yml)",
      "Write(./commitlint.config.cjs)",
      "Write(./pnpm-workspace.yaml)",
      "Write(./pnpm-lock.yaml)",
      "Write(./tsconfig.base.json)",
      "Write(./package.json)",
      "Write(./.gitignore)",
      "Write(./.github/**)",
      "Write(./contracts/**)",
      "Write(./docs/architecture/**)",
      "Write(./.claude/**)",
      "Write(./scripts/seed-issues.sh)",
      "Write(./scripts/lint-comments.mjs)",
      "Edit(./CLAUDE.md)",
      "Edit(./LICENSE)",
      "Edit(./README.md)",
      "Edit(./CONTRIBUTING.md)",
      "Edit(./biome.json)",
      "Edit(./lefthook.yml)",
      "Edit(./commitlint.config.cjs)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./tsconfig.base.json)",
      "Edit(./package.json)",
      "Edit(./.gitignore)",
      "Edit(./.github/**)",
      "Edit(./contracts/**)",
      "Edit(./docs/architecture/**)",
      "Edit(./.claude/**)",
      "Edit(./scripts/seed-issues.sh)",
      "Edit(./scripts/lint-comments.mjs)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(find * -delete *)",
      "Bash(git clean -*)",
      "Bash(shred *)",
      "Bash(wipe *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git config user.*)",
      "Bash(git config core.*)",
      "Bash(git rebase -i*)",
      "Bash(git push * main)",
      "Bash(git push origin main*)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(curl * .env*)",
      "Bash(vercel *)",
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn add *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(cargo install*)",
      "Bash(brew install*)",
      "Bash(brew update*)",
      "Bash(brew upgrade*)",
      "Bash(forge create*)",
      "Bash(forge verify-contract*)",
      "Bash(forge script * --broadcast*)",
      "Bash(cast send*)",
      "Bash(cast wallet *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(reboot)",
      "Bash(shutdown *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ssh *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(lefthook uninstall*)",
      "Bash(lefthook disable*)",
      "Bash(chmod * .claude*)",
      "Bash(chmod * lefthook*)"
    ],
    "allow": [
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm exec biome*)",
      "Bash(pnpm exec madge*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm exec commitlint*)",
      "Bash(pnpm --filter * typecheck*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * build*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit -m*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push -u origin *)",
      "Bash(git worktree add ../*)",
      "Bash(git worktree remove ../*)",
      "Bash(git worktree list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh api repos/*)",
      "Bash(gh label list*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-guard.mjs"
          }
        ]
      }
    ]
  }
}
