{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)",
      "Read(./packages/*/.env)",
      "Read(./packages/*/.env.*)",
      "Bash(cat .env*)",
      "Bash(grep * .env*)",
      "Bash(vercel deploy*)",
      "Bash(vercel env *)",
      "Bash(vercel login*)",
      "Bash(vercel link*)",
      "Bash(vercel switch*)",
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf*)",
      "Bash(curl * .env*)",
      "Bash(forge create*)",
      "Bash(cast send*)",
      "Bash(cast wallet sign*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/env-guard.mjs"
          }
        ]
      }
    ]
  }
}
