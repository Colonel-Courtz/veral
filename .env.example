# Veral environment variables — copy to .env (never commit .env)

# ─── RPC Providers ─────────────────────────────────────────────
ALCHEMY_API_KEY=
INFURA_API_KEY=

# ─── Source APIs ───────────────────────────────────────────────
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
SOURCIFY_BASE_URL=https://sourcify.dev/server

# ─── Storage (Vercel Marketplace, auto-injected via integration) ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Note: Upstash injects KV_REST_API_* (legacy Vercel KV naming, preserved by Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# ─── AI Gateway (Vercel) ───────────────────────────────────────
AI_GATEWAY_API_KEY=

# ─── Operator Wallet (EIP-712 signer) ──────────────────────────
# Same key for OPERATOR (ENS record updater) and REPORT_SIGNER (EIP-712).
# Single key collapses GATE invariant `recoveredSigner == owner` to identity.
OPERATOR_PRIVATE_KEY=
REPORT_SIGNER_PRIVATE_KEY=

# ─── Deployer (Foundry, Sepolia fixtures) ──────────────────────
DEPLOYER_PRIVATE_KEY=

# ─── EAS schemas ───────────────────────────────────────────────
EAS_SCHEMA_UID_MAINNET=
EAS_SCHEMA_UID_SEPOLIA=
