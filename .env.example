# Veral environment variables — copy to .env (never commit .env)

# ─── RPC Providers ─────────────────────────────────────────────
ALCHEMY_API_KEY=
INFURA_API_KEY=

# ─── Source APIs ───────────────────────────────────────────────
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
SOURCIFY_BASE_URL=https://sourcify.dev/server

# ─── Storage (Vercel Marketplace) ──────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI Gateway (Vercel) ───────────────────────────────────────
AI_GATEWAY_API_KEY=

# ─── Operator Wallet (EIP-712 signer) ──────────────────────────
# Same key for OPERATOR (ENS record updater) and REPORT_SIGNER (EIP-712).
# Single key collapses GATE invariant `recoveredSigner == owner` to identity.
OPERATOR_PRIVATE_KEY=
REPORT_SIGNER_PRIVATE_KEY=

# ─── Deployer (Foundry, Sepolia fixtures) ──────────────────────
DEPLOYER_PRIVATE_KEY=

# ─── EAS schemas ───────────────────────────────────────────────
EAS_SCHEMA_UID_MAINNET=
EAS_SCHEMA_UID_SEPOLIA=
